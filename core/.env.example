# ==============================================================================
# Orbit Configuration
# ==============================================================================

# LLM Inference (OpenRouter, OpenAI, Local Ollama, or any OpenAI-compatible API)
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=anthropic/claude-3.5-sonnet
LLM_BASE_URL=https://openrouter.ai/api/v1
# Note: You can also use OPENROUTER_API_KEY / OPENAI_API_KEY as aliases.

# Web Data Retrieval & Resilient Proxy (Bright Data, ScrapingBee, or custom proxy)
RETRIEVAL_API_KEY=your_retrieval_api_key_here
RETRIEVAL_ZONE=your_proxy_zone_name
RETRIEVAL_BASE_URL=https://api.brightdata.com
# Note: You can also use BRIGHTDATA_API_KEY / BRIGHTDATA_ZONE as aliases.

# Web Discovery (SerpApi, Google Search API, or custom search engine endpoint)
# Optional: If omitted, Orbit automatically falls back to Open Web Search without API keys.
SEARCH_ENGINE_API_KEY=your_search_engine_api_key_here
SEARCH_ENGINE_BASE_URL=https://serpapi.com/search.json
# Note: You can also use SERPAPI_API_KEY as an alias.

# Persistence (PostgreSQL)
DATABASE_URL=postgresql+psycopg2://orbit:orbit@localhost:5432/orbit

# Scheduler Daemon
ENABLE_SCHEDULER=true

# Alerts & Downstream Webhooks (Optional)
DEFAULT_WEBHOOK_URL=https://example.com/webhook

