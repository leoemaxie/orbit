# ==============================================================================
# Orbit Core Python Daemon - Environment Configuration Template
# ==============================================================================
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO
ENABLE_SCHEDULER=true
ORBIT_SECRET_KEY=change-this-to-a-secure-32-character-secret-key!

# Database
DATABASE_URL=postgresql+psycopg2://orbit:orbit@localhost:5432/orbit

# LLM Inference Provider
LLM_API_KEY=
LLM_MODEL=anthropic/claude-3.5-sonnet
LLM_BASE_URL=https://openrouter.ai/api/v1

# Web Retrieval, Proxies & Discovery
RETRIEVAL_API_KEY=
RETRIEVAL_ZONE=
RETRIEVAL_BASE_URL=https://api.brightdata.com
SEARCH_ENGINE_API_KEY=
SEARCH_ENGINE_BASE_URL=https://serpapi.com/search.json

# Foxit PDF Services (Format Normalization, OCR & Template Merging)
DOCUMENT_CONVERTER_API_KEY=
DOCUMENT_CONVERTER_BASE_URL=https://api.foxit.com/v1

# Docling Inbound Ingestion Parser (Layout & Tables)
DOCUMENT_PARSER_API_KEY=
DOCUMENT_PARSER_BASE_URL=https://api.docling.ai/v1

# Nutrient Platform (HTML-to-PDF Reports & PII Data Redaction)
DOCUMENT_GENERATOR_API_KEY=
DOCUMENT_GENERATOR_BASE_URL=https://api.nutrient.io/v1
DOCUMENT_REDACTOR_API_KEY=
DOCUMENT_REDACTOR_BASE_URL=https://api.nutrient.io/v1

# Email Notifications (Provider-Agnostic Managed & Custom Gateway)
EMAIL_API_KEY=
EMAIL_SENDER_ADDRESS="Orbit Alerts <alerts@orbit.dev>"
EMAIL_BASE_URL=https://api.orbit.dev/v1/emails
