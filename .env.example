# LLM (via OpenRouter or OpenAI-compatible endpoint)
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Web data retrieval (Bright Data Web Unlocker)
BRIGHTDATA_API_KEY=your_brightdata_key_here
BRIGHTDATA_ZONE=your_brightdata_zone_name
BRIGHTDATA_BASE_URL=https://api.brightdata.com

# Web discovery (SerpApi Google Search)
SERPAPI_API_KEY=your_serpapi_key_here

# Database
DATABASE_URL=postgresql+psycopg2://orbit:orbit@localhost:5432/orbit

# Scheduler
ENABLE_SCHEDULER=true

# Alerts & Notifications (optional)
DEFAULT_WEBHOOK_URL=https://example.com/webhook
