# ==============================================================================
# Orbit Data & AI Engineering Platform - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' or 'core/.env' and fill in your target configuration.

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & SECURITY
# ------------------------------------------------------------------------------
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO
ENABLE_SCHEDULER=true
# 32-byte master key for AES-128/Fernet encryption of custom user secrets at rest
ORBIT_SECRET_KEY=change-this-to-a-secure-32-character-secret-key!

# ------------------------------------------------------------------------------
# 2. DATABASE & WAREHOUSE
# ------------------------------------------------------------------------------
# Default PostgreSQL connection URI (SQLite fallback: sqlite:///./orbit.db)
DATABASE_URL=postgresql+psycopg2://orbit:orbit@localhost:5432/orbit

# ------------------------------------------------------------------------------
# 3. LLM INFERENCE (OpenAI-compatible: OpenRouter, OpenAI, Local Ollama, vLLM)
# ------------------------------------------------------------------------------
LLM_API_KEY=
LLM_MODEL=anthropic/claude-3.5-sonnet
LLM_BASE_URL=https://openrouter.ai/api/v1
# Aliases supported: OPENROUTER_API_KEY, OPENROUTER_MODEL, OPENAI_API_KEY

# ------------------------------------------------------------------------------
# 4. WEB DATA RETRIEVAL, PROXIES & SEARCH DISCOVERY
# ------------------------------------------------------------------------------
# Proxy & Unblocker gateway (Aliases supported: BRIGHTDATA_API_KEY, PROXY_API_KEY)
RETRIEVAL_API_KEY=
RETRIEVAL_ZONE=
RETRIEVAL_BASE_URL=https://api.brightdata.com
# Search Engine API (Aliases supported: SERPAPI_API_KEY, DISCOVERY_API_KEY)
SEARCH_ENGINE_API_KEY=
SEARCH_ENGINE_BASE_URL=https://serpapi.com/search.json

# ------------------------------------------------------------------------------
# 5. DOCUMENT PROCESSING, CONVERSION & OCR (Foxit & Docling Engines)
# ------------------------------------------------------------------------------
# Foxit PDF Services: DOCX/XLSX to PDF/A normalization, OCR & Template Merging
DOCUMENT_CONVERTER_API_KEY=
DOCUMENT_CONVERTER_BASE_URL=https://api.foxit.com/v1
# Aliases supported: FOXIT_API_KEY, FOXIT_CLIENT_ID

# Docling Inbound Ingestion Parser (Layout deconstruction & table extraction)
DOCUMENT_PARSER_API_KEY=
DOCUMENT_PARSER_BASE_URL=https://api.docling.ai/v1
# Aliases supported: DOCLING_API_KEY

# ------------------------------------------------------------------------------
# 6. PDF REPORT GENERATION & PII DATA REDACTION (Nutrient Engine)
# ------------------------------------------------------------------------------
# Nutrient (formerly PSPDFKit): HTML/CSS-to-PDF rendering & PII compliance masking
DOCUMENT_GENERATOR_API_KEY=
DOCUMENT_GENERATOR_BASE_URL=https://api.nutrient.io/v1
DOCUMENT_REDACTOR_API_KEY=
DOCUMENT_REDACTOR_BASE_URL=https://api.nutrient.io/v1
# Aliases supported: NUTRIENT_API_KEY, PSPDFKIT_API_KEY

# ------------------------------------------------------------------------------
# 7. OUTBOUND TRANSACTIONAL EMAIL (Managed Outbound Email Gateway)
# ------------------------------------------------------------------------------
# Provider-agnostic outbound email credentials for condition alerts
EMAIL_API_KEY=
EMAIL_SENDER_ADDRESS=Orbit Alerts <alerts@orbit.dev>
EMAIL_BASE_URL=https://api.orbit.dev/v1/emails
# Aliases supported: MAIL_API_KEY, SMTP_API_KEY, EMAIL_FROM
