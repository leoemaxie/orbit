# LLM (via OpenRouter)
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Web data
BRIGHTDATA_API_KEY=your_brightdata_key_here
# Web Unlocker zone name, from Bright Data control panel -> your zone -> Overview tab
BRIGHTDATA_ZONE=your_zone_name_here
BRIGHTDATA_BASE_URL=https://api.brightdata.com

SERPAPI_API_KEY=your_serpapi_key_here

# Database
DATABASE_URL=postgresql+psycopg2://orbit:orbit@localhost:5432/orbit

# App
ORBIT_ALLOWED_RETAILERS=jumia.com.ng,konga.com,slot.ng,pointekonline.com
